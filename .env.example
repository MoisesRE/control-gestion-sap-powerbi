# Copiar a .env y rellenar. El fichero .env esta en .gitignore.

# --- Pseudonimizacion -------------------------------------------------------
# Clave HMAC que hace reproducible el mapeo de identificadores. Debe ser
# estable entre ejecuciones (si cambia, cambian todos los pseudonimos) y
# secreta (con ella se puede reconstruir el mapa original).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
ANON_SALT=cambiar_por_un_valor_aleatorio_de_64_hex

# Factor multiplicativo aplicado a todos los importes. Un unico factor global
# preserva margenes, ratios y variaciones interanuales.
ANON_FACTOR_IMPORTE=1.3742

# --- PostgreSQL (etapa 2) ---------------------------------------------------
# Credencial del ETL: crea la base, aplica el DDL y carga. Necesita escritura.
PGHOST=localhost
PGPORT=5432
PGDATABASE=finanzas_analytics
PGUSER=postgres
PGPASSWORD=

# --- Power BI (etapa 3) -----------------------------------------------------
# Credencial del modelo semantico: solo lectura. El rol de grupo bi_modeler se
# declara en sql/06_permisos.sql, pero el usuario que se autentica se crea
# fuera del repositorio para no versionar ninguna contrasena:
#
#     CREATE ROLE powerbi LOGIN PASSWORD '...';
#     GRANT bi_modeler TO powerbi;
#
# Power BI Desktop pide esta credencial en el primer refresco y la guarda en su
# propio almacen; estas variables existen para documentarla y para los scripts
# de validacion.
PGUSER_BI=powerbi
PGPASSWORD_BI=
